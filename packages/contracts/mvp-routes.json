{
  "$comment": [
    "MVP 路由允许清单：BFF 只代理这里冻结的 method + path 模板，其余管理操作一律 404 WEBUI_ROUTE_NOT_ALLOWED。",
    "每条 path 必须与 packages/contracts/upstream.openapi.json 完全一致，scripts/generate-contracts.mjs 会在生成时逐条核对，缺失即失败。",
    "class=auth 的路由不进入通用业务代理，只能由 BFF 认证控制器调用。",
    "excluded 段落记录本版明确不开放的上游能力，避免被误认为遗漏。"
  ],
  "routes": [
    { "method": "GET", "path": "/api/management/v1/meta", "class": "proxy", "note": "版本/元信息与兼容性判断" },
    { "method": "GET", "path": "/api/management/v1/capabilities", "class": "proxy", "note": "能力矩阵，决定前端模块可用性" },

    { "method": "GET", "path": "/api/management/v1/operations/{operationId}", "class": "proxy", "note": "异步任务查询" },
    { "method": "DELETE", "path": "/api/management/v1/operations/{operationId}", "class": "proxy", "note": "取消任务，仅 cancellable=true 时前端放行" },

    { "method": "GET", "path": "/api/management/v1/overview", "class": "proxy", "note": "总览" },
    { "method": "GET", "path": "/api/management/v1/stats/summary", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/stats/breakdown", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/stats/recent-calls", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/stats/models/{modelId}", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/runtime/status", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/runtime/concurrency", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/runtime/cooldowns", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/runtime/background-jobs", "class": "proxy" },

    { "method": "GET", "path": "/api/management/v1/channels", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/channels", "class": "proxy", "bodyLimit": "1mb" },
    { "method": "GET", "path": "/api/management/v1/channels/{channelId}", "class": "proxy" },
    { "method": "PATCH", "path": "/api/management/v1/channels/{channelId}", "class": "proxy", "bodyLimit": "1mb" },
    { "method": "DELETE", "path": "/api/management/v1/channels/{channelId}", "class": "proxy" },
    { "method": "PUT", "path": "/api/management/v1/channels/order", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/channel-catalog", "class": "proxy", "note": "新建渠道的供应商/协议目录" },
    { "method": "POST", "path": "/api/management/v1/channel-drafts/probes", "class": "proxy", "note": "新渠道草稿诊断（与既有渠道诊断是两个动作）" },
    { "method": "POST", "path": "/api/management/v1/channel-model-discoveries", "class": "proxy", "note": "新渠道模型发现" },
    { "method": "POST", "path": "/api/management/v1/channels/{channelId}/diagnostic-probes", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/channels/{channelId}/actions/refresh-usage", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/channels/{channelId}/actions/clear-errors", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/channels/{channelId}/actions/clear-affinity", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/channels/actions/clear-errors", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/channels/actions/clear-affinity", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/channels/{channelId}/compatibility", "class": "proxy" },
    { "method": "PATCH", "path": "/api/management/v1/channels/{channelId}/compatibility", "class": "proxy" },

    { "method": "GET", "path": "/api/management/v1/oauth/accounts", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/accounts", "class": "proxy", "bodyLimit": "1mb" },
    { "method": "GET", "path": "/api/management/v1/oauth/accounts/{accountId}", "class": "proxy" },
    { "method": "PATCH", "path": "/api/management/v1/oauth/accounts/{accountId}", "class": "proxy", "bodyLimit": "1mb" },
    { "method": "DELETE", "path": "/api/management/v1/oauth/accounts/{accountId}", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/accounts/{accountId}/actions/refresh-token", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/accounts/{accountId}/actions/refresh-usage", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/accounts/{accountId}/actions/clear-errors", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/accounts/{accountId}/actions/clear-affinity", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/oauth/accounts/{accountId}/models", "class": "proxy" },
    { "method": "PATCH", "path": "/api/management/v1/oauth/accounts/{accountId}/models", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/accounts/{accountId}/models/actions/sync", "class": "proxy" },
    { "method": "PATCH", "path": "/api/management/v1/oauth/accounts/{accountId}/models/settings", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/actions/refresh-usage", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/actions/clear-errors", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/oauth/invalid-accounts", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/oauth/settings", "class": "proxy" },
    { "method": "PATCH", "path": "/api/management/v1/oauth/settings", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/login-flows", "class": "proxy", "note": "发起 OAuth 登录" },
    { "method": "POST", "path": "/api/management/v1/oauth/login-flows/{flowId}/poll", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/login-flows/{flowId}/complete", "class": "proxy", "bodyLimit": "1mb" },
    { "method": "POST", "path": "/api/management/v1/oauth/login-flows/{flowId}/cancel", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/oauth/imports/preview", "class": "proxy", "bodyLimit": "5mb", "note": "导入预览，OAuth 导入 body 单独限额" },
    { "method": "POST", "path": "/api/management/v1/oauth/imports/{importId}/commit", "class": "proxy", "bodyLimit": "5mb" },

    { "method": "GET", "path": "/api/management/v1/models", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/models/{resource_key}", "class": "proxy", "note": "resourceKey 由服务端提供，前端不自行拼接" },
    { "method": "PATCH", "path": "/api/management/v1/models/actions/state", "class": "proxy", "note": "需要 If-Match revision" },

    { "method": "GET", "path": "/api/management/v1/api-keys", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/api-keys", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/api-keys/{keyId}", "class": "proxy" },
    { "method": "PATCH", "path": "/api/management/v1/api-keys/{keyId}", "class": "proxy" },
    { "method": "DELETE", "path": "/api/management/v1/api-keys/{keyId}", "class": "proxy" },
    { "method": "PUT", "path": "/api/management/v1/api-keys/{keyId}/secret", "class": "proxy", "note": "重置密钥，需要 plan/commit 时按真实流程" },
    { "method": "POST", "path": "/api/management/v1/api-keys/{keyId}/actions/reset-limiter", "class": "proxy" },
    { "method": "POST", "path": "/api/management/v1/api-keys/{keyId}/actions/generate-replacement-plan", "class": "proxy", "note": "替换计划，MVP 仅查询计划" },
    { "method": "GET", "path": "/api/management/v1/api-keys/{keyId}/stats", "class": "proxy" },
    { "method": "PUT", "path": "/api/management/v1/api-keys/order", "class": "proxy" },

    { "method": "GET", "path": "/api/management/v1/logs", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/logs/filter-options", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/logs/{logId}", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/logs/{logId}/body", "class": "proxy", "note": "默认不加载，用户主动展开" },
    { "method": "GET", "path": "/api/management/v1/logs/{logId}/body/items/{itemId}", "class": "proxy" },
    { "method": "GET", "path": "/api/management/v1/logs/{logId}/raw-body", "class": "proxy" },

    { "method": "POST", "path": "/api/management/v1/auth/sessions", "class": "auth", "note": "管理密钥换上游 Session，仅认证控制器可调用" },
    { "method": "GET", "path": "/api/management/v1/auth/session", "class": "auth", "note": "会话摘要/idle 刷新" },
    { "method": "DELETE", "path": "/api/management/v1/auth/session", "class": "auth", "note": "上游注销，仅注销控制器可调用" }
  ],
  "excluded": {
    "phase2": [
      "/api/management/v1/auth/telegram-approvals",
      "/api/management/v1/oauth/accounts/{accountId}/actions/reset-quota",
      "/api/management/v1/oauth/accounts/{accountId}/actions/reset-quota-plan",
      "/api/management/v1/oauth/accounts/{accountId}/workbuddy",
      "/api/management/v1/oauth/accounts/{accountId}/workbuddy/action-plans",
      "/api/management/v1/oauth/accounts/{accountId}/workbuddy/action-records",
      "/api/management/v1/oauth/accounts/{accountId}/workbuddy/actions/execute",
      "/api/management/v1/oauth/accounts/{accountId}/workbuddy/actions/refresh-status",
      "/api/management/v1/oauth/accounts/{accountId}/workbuddy/settings",
      "/api/management/v1/preferences/telegram/oauth",
      "/api/management/v1/preferences/telegram/stats",
      "/api/management/v1/oauth/invalid-accounts/delete",
      "/api/management/v1/oauth/invalid-accounts/delete-plan",
      "/api/management/v1/api-keys/{keyId}/actions/generate-replacement"
    ],
    "reason": "第二阶段或本版明确不开放；其中 updates/*（更新与重启）、system/*、network/*、mcp/*、retention/*、proxy/* 等高风险或非 MVP 能力整体不进入允许清单。"
  }
}
