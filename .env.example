# Parrot 独立 WebUI 环境变量示例
#
# 用法：cp .env.example .env 后逐项填写（.env 已被 .gitignore 忽略，不要提交）。
# Compose 会自动读取同目录的 .env 做变量插值；本文件本身不含任何真实秘密。
#
# 命名、默认值、取值区间与校验规则全部以 apps/bff/src/config.ts 为准（BFF 启动时严格校验，
# 不满足即退出并打印中文配置错误）。标注"必填"的项缺失时容器无法启动。
#
# ⚠️ 这里不得、也不需要设置任何共享管理密钥。
#    Parrot 管理主密钥只应出现在浏览器登录表单里，随登录请求到达 BFF 后仅用于向本机 Parrot
#    换取上游 Session 票据；BFF 不把它写入环境变量、不落盘、不写日志。任何形如
#    PARROT_ADMIN_KEY / WEBUI_ADMIN_KEY 的变量都是错误做法（见 docs/security-model.md）。

# ----------------------------------------------------------------- 进程与监听
# 运行模式。生产部署必须是 production，否则不会启用 Secure Cookie，也会放宽 Origin 校验。
# 取值：production | development（默认 development）
NODE_ENV=production

# 容器内监听地址。默认 0.0.0.0（只服务同机反向代理；不要把它当作对外发布端口）。
# 可选，默认 0.0.0.0
WEBUI_BIND_HOST=0.0.0.0

# 容器内端口。宿主发布必须限回环（见 compose.yaml），不允许直接对公网发布。
# 可选，默认 3000，取值 1-65535
PORT=3000

# 对外挂载前缀。首版固定 /webui/，改成别的值会直接启动失败（前端 base、BFF 路径、
# Cookie Path 必须一致）。可选，默认 /webui/
WEBUI_BASE_PATH=/webui/

# 静态资源目录。镜像内固定指向 web 构建产物，一般不需要改。
# 可选，默认是相对 BFF 产物计算的 apps/web/dist
WEBUI_STATIC_DIR=/app/apps/web/dist

# ----------------------------------------------------------------- 必填：目标与来源
# 必填。本机原 Parrot 的既有内部 origin，例如 http://host.docker.internal:22122。
# 只能是 origin：不允许带用户密码、query、fragment，也不允许带路径
# （不要写 /api/management/v1，管理前缀由 BFF 自己拼接）。
# 校验：必须与 WEBUI_PUBLIC_ORIGIN 不同，否则会形成 /webui/ 代理循环，启动即失败。
PARROT_BASE_URL=http://host.docker.internal:22122

# 必填。现有 Parrot 的 HTTPS origin，例如 https://parrot.example.com，不含路径。
# 这是唯一合法浏览器来源，也是 Host 校验基准；必须现场确认与用户实际使用的域名完全一致。
WEBUI_PUBLIC_ORIGIN=https://parrot.example.com

# 必填（production）。实际入口反向代理地址或 CIDR，逗号分隔，例如 127.0.0.1 或 172.18.0.0/16。
# 禁止填写 * 或 true（会导致启动失败）。请勿照抄示例值：填错会让限流键和客户端来源判断失真，
# 需要与真实入口网络一致（见 docs/deployment.md 的「待现场确认」）。
WEBUI_TRUST_PROXY=127.0.0.1

# 展示名称，会出现在登录页/页面标题/诊断信息里。可选，默认 Parrot
WEBUI_INSTANCE_NAME=My Parrot

# ----------------------------------------------------------------- 诊断
# 是否在诊断接口中显示原始上游地址。默认 0（不显示）。仅排障时临时设为 1。
WEBUI_DIAGNOSTICS_EXPOSE_UPSTREAM=0

# ----------------------------------------------------------------- 会话有效期
# 本地会话空闲有效期（秒）。可选，默认 1800，取值 60-86400
WEBUI_SESSION_IDLE_SECONDS=1800

# 本地会话绝对有效期（秒）。可选，默认 28800，取值 300-604800，且不得小于空闲有效期。
# 实际有效期还受上游 Session 截止时间限制（以两者中更早者为准）。
WEBUI_SESSION_MAX_SECONDS=28800

# 有界会话表容量。可选，默认 WEBUI_MAX_SESSIONS=100、WEBUI_MAX_PRELOGIN_SESSIONS=200
# WEBUI_MAX_SESSIONS=100
# WEBUI_MAX_PRELOGIN_SESSIONS=200

# ----------------------------------------------------------------- 上游超时与体积
# 连接本机 Parrot 的连接超时（毫秒）。可选，默认 5000，取值 200-120000
PARROT_CONNECT_TIMEOUT_MS=5000

# 普通管理请求总超时（毫秒）。可选，默认 30000，取值 1000-600000
PARROT_REQUEST_TIMEOUT_MS=30000

# 上游 JSON 响应上限（字节）。可选，默认 10485760（10MiB），取值 1024-209715200
# WEBUI_MAX_UPSTREAM_RESPONSE_BYTES=10485760

# 普通请求体上限（字节）。可选，默认 1048576（1MiB）
# WEBUI_BODY_LIMIT_BYTES=1048576

# OAuth 导入请求体上限（字节）。可选，默认 5242880（5MiB）
# WEBUI_OAUTH_IMPORT_BODY_LIMIT_BYTES=5242880

# ----------------------------------------------------------------- 限流与并发（防暴力破解/防打爆上游）
# 登录：每来源每分钟 5 次、全局每分钟 30 次；并发上限 4
# WEBUI_LOGIN_PER_SOURCE_PER_MINUTE=5
# WEBUI_LOGIN_GLOBAL_PER_MINUTE=30
# WEBUI_MAX_CONCURRENT_LOGIN=4

# 预登录 bootstrap：每来源每分钟 20 次、全局每分钟 100 次；并发上限 8
# WEBUI_BOOTSTRAP_PER_SOURCE_PER_MINUTE=20
# WEBUI_BOOTSTRAP_GLOBAL_PER_MINUTE=100
# WEBUI_MAX_CONCURRENT_BOOTSTRAP=8

# ----------------------------------------------------------------- 日志
# 脱敏日志级别。可选，默认 info（例如 error | warn | info | debug），不记录请求体/响应体/Cookie/密钥。
LOG_LEVEL=info

# ----------------------------------------------------------------- 仅开发用途（生产不要设置）
# 允许 production 模式使用 http:// 的 PUBLIC_ORIGIN。默认 false；生产开启会削弱来源校验。
# WEBUI_ALLOW_INSECURE_PUBLIC_ORIGIN=0

# 开发模式下关闭 Secure Cookie。默认在非 production 环境为 true；production 恒为 Secure，此项无效。
# WEBUI_DEV_INSECURE_COOKIES=1
